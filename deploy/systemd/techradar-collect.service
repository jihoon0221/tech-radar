[Unit]
Description=tech-radar 매일 수집 (새로 뜬 저장소 + 스타 추적)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python -m techradar
# 수집이 실패해도 백업은 한다 (ExecStartPost 는 성공했을 때만 돌아서 10/28~11/8 백업이 빠졌음)
ExecStopPost=@APP_DIR@/deploy/backup_db.sh
TimeoutStartSec=30min
Nice=10
MemoryMax=300M
